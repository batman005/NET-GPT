# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=network_ai

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=MODEL_NAME

# Connection Pool Configuration
# Increased pool size for handling concurrent requests
DB_POOL_SIZE=20

# Async Configuration
# Number of worker threads for concurrent pipeline execution
ASYNC_WORKER_THREADS=10

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Logs are written to:
# - logs/app.log (all logs in JSON format)
# - logs/error.log (errors only)
# - logs/pipeline.log (pipeline execution)
# - logs/queries.log (query analytics)
# Log rotation: 10MB max per file, 5 backups

# Schema Cache TTL (in seconds)
SCHEMA_CACHE_TTL=3600

# Request Tracking
# Track requests with unique IDs for debugging
REQUEST_TRACING_ENABLED=true


